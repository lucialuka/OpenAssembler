.version 8.7
.target sm_80
.address_size 64
.visible .entry decimal(.param .u64 output,.param .u64 input){
.reg .u64 %out,%input;
.reg .f32 %value;
ld.param.u64 %out,[output];ld.param.u64 %input,[input];
ld.global.f32 %value,[%input];
fma.rn.f32 %value,%value,1.5,0.0;
st.global.f32 [%out],%value;ret;
}
