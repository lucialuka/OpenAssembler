.version 8.7
.target sm_80
.address_size 64
.visible .entry packed_literal(.param .u64 output,.param .u64 input){
.reg .u64 %out,%input;
.reg .u32 %bits;
.reg .f32 %a,%b,%value;
.reg .pred %p;
ld.param.u64 %out,[output];ld.param.u64 %input,[input];
ld.global.f32 %a,[%input];mov.f32 %b,0f40000000;setp.lt.f32 %p,%a,%b;
mov.b64 %out,{1.5,%bits};st.global.u64 [%input],%out;
ret;
}
