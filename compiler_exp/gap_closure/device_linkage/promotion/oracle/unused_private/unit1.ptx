.version 8.7
.target sm_80
.address_size 64
.func (.param .b32 result) unused(.param .b32 input){
.reg .b32 %x,%v;ld.param.b32 %x,[input];mov.b32 %v,%x;st.param.b32 [result],%v;ret;
}
.visible .func (.param .b32 result) helper(.param .b32 input){
.reg .b32 %x,%v;ld.param.b32 %x,[input];add.u32 %v,%x,11;st.param.b32 [result],%v;ret;
}
