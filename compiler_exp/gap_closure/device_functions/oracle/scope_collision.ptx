.version 8.7
.target sm_80
.address_size 64
.func (.param .b32 result) helper(.param .b32 x){.reg .u32 %x,%v;ld.param.u32 %x,[x];mad.lo.u32 %v,%x,17,9;st.param.b32 [result],%v;ret;}
.visible .entry probe(.param .u64 out,.param .u64 input,.param .u32 n){
.reg .u64 %out,%in,%off,%src,%dst,%wide,%__oa_inline_result;.reg .u32 %t,%c,%i,%n,%lo,%hi;.reg .pred %active,%take;
ld.param.u64 %out,[out];ld.param.u64 %in,[input];ld.param.u32 %n,[n];
mov.u32 %t,%tid.x;mov.u32 %c,%ctaid.x;mad.lo.u32 %i,%c,128,%t;setp.lt.u32 %active,%i,%n;
mul.wide.u32 %off,%i,8;add.u64 %src,%in,%off;add.u64 %dst,%out,%off;ld.global.b64 %wide,[%src];mov.b64 {%lo,%hi},%wide;
{.param .b32 a;.param .b32 r;st.param.b32 [a],%lo;call.uni (r),helper,(a);ld.param.u32 %lo,[r];}
{.param .b32 a;.param .b32 r;st.param.b32 [a],%lo;call.uni (r),helper,(a);ld.param.u32 %hi,[r];}
mov.b64 %__oa_inline_result,{%lo,%hi};@%active st.global.b64 [%dst],%__oa_inline_result;ret;}